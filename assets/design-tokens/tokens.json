{
  "version": "1.0",
  "name": "OX-DX Product Handoff Tokens",
  "sources": [
    "assets/documentation/technical/design-tokens.md",
    "assets/documentation/technical/color-system.md",
    "assets/documentation/technical/typography.md",
    "assets/documentation/visual/motion-grammar.md"
  ],
  "color": {
    "void": "#07090A",
    "charcoal": "#111418",
    "graphite": "#20252B",
    "white": "#F5F7F8",
    "muted": "#99A2AA",
    "cyan": "#00D8FF",
    "acid": "#8CFF00",
    "ultraviolet": "#9C4DFF",
    "black": "#000000"
  },
  "space": {
    "micro": "3px",
    "u": "7px",
    "2u": "14px",
    "3u": "21px",
    "5u": "35px",
    "field": "49px",
    "field2": "98px"
  },
  "stroke": {
    "hair": "1px",
    "relation": "3px",
    "structure": "7px"
  },
  "geometry": {
    "radius": "0px",
    "cut": "7px",
    "anchorSm": "7px",
    "anchorMd": "14px",
    "anchorLg": "21px",
    "breakLocal": "7px",
    "breakRelation": "14px",
    "breakUnresolvedMin": "21px"
  },
  "motion": {
    "micro": "98ms",
    "witness": "196ms",
    "resolve": "294ms",
    "field": "490ms",
    "easing": "cubic-bezier(0.21, 0.63, 0.28, 1)"
  },
  "breakpoint": {
    "compact": "420px",
    "medium": "840px",
    "wide": "1260px",
    "ultra": "1680px"
  },
  "font": {
    "sans": "Inter, ui-sans-serif, system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "productAlias": {
    "base": "{color.void}",
    "surface": "{color.charcoal}",
    "surfaceSecondary": "{color.graphite}",
    "text": "{color.white}",
    "muted": "{color.muted}",
    "border": "{color.graphite}",
    "structure": "{color.white}",
    "observation": "{color.cyan}",
    "attention": "{color.acid}",
    "projection": "{color.ultraviolet}",
    "unknown": "{color.muted}"
  },
  "rules": [
    "Aliases reference canonical values and must not drift independently.",
    "Unknown and status meaning require text plus geometry; color alone is insufficient.",
    "No product-specific brand palette, spacing scale, or motion scale is introduced."
  ]
}
