{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ox-dx.dev/schemas/discovery-output-v1.schema.json",
  "title": "OX-DX Discovery Output v1",
  "type": "object",
  "required": [
    "schema",
    "ontology",
    "workspace",
    "read_only",
    "mode",
    "nodes",
    "edges",
    "nodes_by_level",
    "observations"
  ],
  "properties": {
    "schema": {
      "const": "universal-ontology-engine/discovery-v1"
    },
    "ontology": {
      "type": "string"
    },
    "workspace": {
      "type": "string"
    },
    "read_only": {
      "const": true
    },
    "mode": {
      "enum": ["structural", "rust-ast", "syntax-projection"]
    },
    "nodes": {
      "type": "integer",
      "minimum": 1
    },
    "edges": {
      "type": "integer",
      "minimum": 0
    },
    "nodes_by_level": {
      "type": "object",
      "patternProperties": {
        "^[0-9]{2}_[A-Z0-9_]+$": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "language", "evidence"],
        "properties": {
          "path": { "type": "string" },
          "kind": { "type": "string" },
          "language": {
            "type": ["string", "null"]
          },
          "evidence": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
