{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bjo163/universe-foundation/blob/main/schemas/ecosystem-manifest.schema.json",
  "title": "Ecosystem Manifest Envelope",
  "type": "object",
  "required": ["contract_version", "id", "name", "foundation"],
  "properties": {
    "contract_version": {"const": "0.1"},
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "foundation": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "version": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "organization": {"type": "string", "minLength": 1},
    "lifecycle": {"type": "string", "enum": ["planned", "active", "maintenance", "archived"]},
    "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "links": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
