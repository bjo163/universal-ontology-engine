{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bjo163/universe-foundation/blob/main/schemas/foundation-node.schema.json",
  "title": "Universal Foundation Node",
  "type": "object",
  "required": ["id", "type", "parent"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "type": {"enum": ["UNIVERSE", "CREATION", "COSMIC_ORDER", "REALITY", "REALM", "WORLD", "ECOSYSTEM", "ORGANIZATION", "DOMAIN", "PROJECT", "REPOSITORY", "SOURCE", "UNIT", "MODULE", "COMPONENT", "ELEMENT", "IMPLEMENTATION"]},
    "parent": {"type": ["string", "null"]},
    "name": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "native_type": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "lifecycle": {"enum": ["planned", "active", "maintenance", "archived"]},
    "children": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "relationships": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
