{
  "version": "0.3",
  "hierarchy": [
    "UNIVERSE",
    "ECOSYSTEM",
    "ORGANIZATION",
    "DOMAIN",
    "PROJECT",
    "REPOSITORY",
    "SOURCE",
    "UNIT",
    "MODULE",
    "COMPONENT",
    "ELEMENT",
    "IMPLEMENTATION"
  ],
  "optionalLayers": ["ORGANIZATION", "DOMAIN"],
  "supportingDimensions": [
    "tests",
    "examples",
    "fixtures",
    "tools",
    "scripts",
    "configuration",
    "data",
    "documentation",
    "specifications",
    "infrastructure",
    "deployment",
    "assets"
  ],
  "nativeMappings": {
    "rust": ["crate", "module", "function", "struct", "trait", "impl"],
    "node": ["package", "application", "library", "module", "function", "class"],
    "go": ["package", "command", "service", "function", "type", "method"],
    "python": ["package", "module", "class", "function", "method"],
    "java": ["module", "package", "application", "class", "method", "interface"]
  },
  "rules": {
    "singleFoundation": true,
    "semanticDirectories": false,
    "externalSystems": "relationship",
    "stableIdentity": true
  }
}
