{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bjo163/universe-foundation/blob/main/specifications/foundation-contract.json",
  "title": "Universal Ontology Foundation Contract",
  "type": "object",
  "required": ["version", "ontology", "zones", "levelsPerZone", "canonicalLevels", "hierarchy", "rules"],
  "properties": {
    "version": {"const": "1.0.0"},
    "ontology": {"const": "Universal Ontology v1.0.0"},
    "zones": {"const": 7},
    "levelsPerZone": {"const": 7},
    "canonicalLevels": {"const": 49},
    "hierarchy": {
      "type": "array",
      "minItems": 49,
      "maxItems": 49,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "optionalLevels": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "supportingDimensions": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "rules": {
      "type": "object",
      "required": [
        "singleFoundation", "semanticDirectories", "externalSystems", "stableIdentity",
        "typeIsCanonicalLevel", "kindIsSpecialization", "projectionDistinctFromContainment",
        "representationDistinctFromSemantics", "intermediateLevelsMayBeUnmaterialized"
      ],
      "properties": {
        "singleFoundation": {"const": true},
        "semanticDirectories": {"const": false},
        "externalSystems": {"const": "relationship"},
        "stableIdentity": {"const": true},
        "typeIsCanonicalLevel": {"const": true},
        "kindIsSpecialization": {"const": true},
        "projectionDistinctFromContainment": {"const": true},
        "representationDistinctFromSemantics": {"const": true},
        "intermediateLevelsMayBeUnmaterialized": {"const": true},
        "creatorOutsideModel": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
