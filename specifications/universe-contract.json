{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bjo163/universe-foundation/blob/main/specifications/universe-contract.json",
  "title": "Universe Foundation Contract",
  "type": "object",
  "required": ["contract_version", "hierarchy", "canonicalVocabulary", "universe", "ecosystems"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "hierarchy": {
      "type": "array",
      "const": [
        "UNIVERSE", "CREATION", "COSMIC_ORDER", "REALITY", "REALM", "WORLD", "ECOSYSTEM",
        "ORGANIZATION", "DOMAIN", "PROJECT", "REPOSITORY", "SOURCE", "UNIT", "MODULE",
        "COMPONENT", "ELEMENT", "IMPLEMENTATION"
      ]
    },
    "canonicalVocabulary": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true,
      "minItems": 17
    },
    "universe": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "ecosystems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "path"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "repository": {"type": "string"},
          "organization": {"type": "string"},
          "lifecycle": {"type": "string", "enum": ["planned", "active", "maintenance", "archived"]},
          "contract": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
